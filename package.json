{
  "name": "youbike-live",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "台灣 YouBike 即時站點查詢 — 全台車輛/空位即時狀態，vinext 靜態匯出至 GitHub Pages",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build && bun scripts/package-pages.mjs",
    "audit:responsive": "bun scripts/responsive-audit.mjs",
    "preview": "vinext preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "package:pages": "bun scripts/package-pages.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vinext": "^1.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.3.7",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
